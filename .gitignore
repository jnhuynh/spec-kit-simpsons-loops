# Simpsons loops - installed copies generated by `setup.sh --self`.
# Run --self locally when you want to dogfood; the output is never committed.
# Source of truth is speckit-skills/, claude-agents/, specify-marge/, scripts/.
.claude/agents/
.claude/skills/
.claude/hooks/
.claude/settings.json
.specify/marge/baseline/
.specify/marge/README.md
.specify/marge/config/README.md
.specify/marge/run-gates.sh
.specify/scripts/bash/speckit-commit.sh
.specify/scripts/bash/speckit-standards.sh
.specify/marge/config/damage-levels.yml
.specify/marge/config/lexicon.yml

